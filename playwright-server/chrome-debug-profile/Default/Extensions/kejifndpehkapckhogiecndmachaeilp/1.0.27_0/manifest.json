{
   "action": {
      "default_icon": "icons/icon192.png",
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content-stitch.js" ],
      "matches": [ "*://*.appspot.com/*" ],
      "run_at": "document_idle"
   }, {
      "exclude_matches": [ "*://stitch.withgoogle.com/*", "*://*.appspot.com/*" ],
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "description": "Connect and add a page to your clonewebx.softlite.io project.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ClonewebX Softlite.io",
   "permissions": [ "tabs", "storage", "unlimitedStorage", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.27"
}
