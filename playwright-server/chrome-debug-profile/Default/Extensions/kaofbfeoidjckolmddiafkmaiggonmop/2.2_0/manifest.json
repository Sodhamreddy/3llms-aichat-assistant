{
   "action": {
      "default_icon": "src/images/icon128.png",
      "default_popup": "src/html/popup.html"
   },
   "background": {
      "service_worker": "src/js/background.js"
   },
   "description": "Detect fonts and colors on any website.",
   "externally_connectable": {
      "matches": [ "https://fontpair.co/*", "https://www.fontpair.co/*", "https://fontpair-2025.lovable.app/*", "http://localhost:5173/*" ]
   },
   "icons": {
      "128": "src/images/icon64.png",
      "16": "src/images/icon16.png",
      "48": "src/images/icon32.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Fontpair",
   "permissions": [ "activeTab", "scripting", "storage", "clipboardWrite", "contextMenus", "offscreen" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.2"
}
