# Frontend public env
VITE_PLAYWRIGHT_SERVER_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Login window mode:
# - native: opens a real Chrome window on the same machine as the Playwright server
# - preview: uses the in-app remote browser preview; use this for deployed/cloud servers
VITE_REMOTE_LOGIN_MODE=native

# Backend env
PORT=3001
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin portal
ADMIN_PORTAL_EMAIL=admin@example.com
ADMIN_PORTAL_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
SUPABASE_ADMIN_EMAILS=admin@example.com

# Cloud backend/browser settings
PLAYWRIGHT_HEADLESS=true
REMOTE_BROWSER_WIDTH=1280
REMOTE_BROWSER_HEIGHT=800
REMOTE_SCREENSHOT_QUALITY=58
